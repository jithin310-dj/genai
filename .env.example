# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Primary Gemini model ID for prompt enhancement and SVG diagram generation.
GEMINI_MODEL="gemini-3.1-flash-lite"

# GEMINI_FALLBACK_MODEL: Secondary fallback model used once if GEMINI_MODEL returns 503/429/timeout.
GEMINI_FALLBACK_MODEL="gemini-4-hydrogen"

# HF_TOKEN: Required for Hugging Face Inference Providers text-to-image generation.
# Create a fine-grained token with "Make calls to Inference Providers" permission at:
# https://huggingface.co/settings/tokens
HF_TOKEN=your_token_here

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
